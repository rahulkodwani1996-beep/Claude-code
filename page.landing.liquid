<!-- ─── CART TOAST ─────────────────────────────────────────── -->
<div id="cart-toast" style="position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--navy);color:#fff;padding:12px 24px;border-radius:var(--r);font-size:.85rem;font-weight:600;z-index:400;opacity:0;transition:all .3s;pointer-events:none;white-space:nowrap">
  ✓ Added to cart!
</div>

<script>
// ── Hamburger / drawer ─────────────────────────────────────
var drawer = document.getElementById('nav-drawer');
var hamburger = document.getElementById('hamburger');
hamburger.onclick = function(){
  drawer.classList.add('open');
  document.body.style.overflow = 'hidden';
  hamburger.setAttribute('aria-expanded','true');
};
document.getElementById('drawer-close').onclick = closeDrawer;
document.getElementById('drawer-overlay').onclick = closeDrawer;
function closeDrawer(){
  drawer.classList.remove('open');
  document.body.style.overflow = '';
  hamburger.setAttribute('aria-expanded','false');
}

// ── Countdown ──────────────────────────────────────────────
(function(){
  var end = Date.now() + 3*3600000 + 59*60000 + 47000;
  function tick(){
    var diff = Math.max(0, end - Date.now());
    var h = Math.floor(diff/3600000), m = Math.floor((diff%3600000)/60000), s = Math.floor((diff%60000)/1000);
    document.getElementById('cd-h').textContent = String(h).padStart(2,'0');
    document.getElementById('cd-m').textContent = String(m).padStart(2,'0');
    document.getElementById('cd-s').textContent = String(s).padStart(2,'0');
    if(diff > 0) setTimeout(tick, 1000);
  }
  tick();
})();

// ── Qty stepper ────────────────────────────────────────────
var qty = 1;
function changeQty(delta){
  qty = Math.max(1, Math.min(10, qty + delta));
  document.getElementById('qty-display').textContent = qty;
}

// ── Purchase toggle ────────────────────────────────────────
document.querySelectorAll('input[name="purchase"]').forEach(function(r){
  r.addEventListener('change', function(){
    var isSub = document.getElementById('sub').checked;
    document.getElementById('price-display').textContent = isSub ? '₹339' : '₹399';
    document.getElementById('price-orig').style.display = isSub ? '' : 'none';
    document.getElementById('price-badge').style.display = isSub ? '' : 'none';
  });
});

// ── Size selector ──────────────────────────────────────────
function selectSize(btn){
  document.querySelectorAll('.size-btn').forEach(function(b){
    b.classList.remove('active');
    b.setAttribute('aria-pressed','false');
  });
  btn.classList.add('active');
  btn.setAttribute('aria-pressed','true');
}

// ── Gallery thumbs ─────────────────────────────────────────
function selectThumb(el){
  document.querySelectorAll('.g-thumb').forEach(function(t){ t.classList.remove('active'); });
  el.classList.add('active');
}

// ── PDP accordion ──────────────────────────────────────────
// Initialize: set first item's body to its natural scroll height
(function(){
  var firstBody = document.querySelector('.acc-item.open .acc-body');
  if(firstBody){
    var inner = firstBody.querySelector('.acc-body-inner');
    firstBody.style.maxHeight = inner.scrollHeight + 'px';
  }
})();

function toggleAcc(head){
  var item = head.closest('.acc-item');
  var isOpen = item.classList.contains('open');
  document.querySelectorAll('.acc-item').forEach(function(i){
    i.classList.remove('open');
    i.querySelector('.acc-body').style.maxHeight = '0';
    i.querySelector('.acc-head').setAttribute('aria-expanded','false');
  });
  if(!isOpen){
    item.classList.add('open');
    var body = item.querySelector('.acc-body');
    body.style.maxHeight = item.querySelector('.acc-body-inner').scrollHeight + 'px';
    head.setAttribute('aria-expanded','true');
  }
}

// ── FAQ accordion ──────────────────────────────────────────
// Initialize: set first open FAQ to its natural height
(function(){
  var firstFaq = document.querySelector('.faq-item.open .faq-a');
  if(firstFaq){
    var inner = firstFaq.querySelector('.faq-a-inner');
    firstFaq.style.maxHeight = inner.scrollHeight + 'px';
  }
})();

function toggleFaq(head){
  var item = head.closest('.faq-item');
  var a = item.querySelector('.faq-a');
  var inner = item.querySelector('.faq-a-inner');
  var isOpen = item.classList.contains('open');
  item.classList.toggle('open');
  a.style.maxHeight = isOpen ? '0' : inner.scrollHeight + 'px';
  head.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
}

// ── Cart toast ─────────────────────────────────────────────
function addToCart(){
  var toast = document.getElementById('cart-toast');
  toast.style.opacity = '1';
  toast.style.transform = 'translateX(-50%) translateY(0)';
  setTimeout(function(){
    toast.style.opacity = '0';
    toast.style.transform = 'translateX(-50%) translateY(20px)';
  }, 2500);
}

// ── Sticky ATC ─────────────────────────────────────────────
var stickyAtc = document.getElementById('sticky-atc');
var heroEl = document.getElementById('hero');
window.addEventListener('scroll', function(){
  stickyAtc.classList.toggle('visible', heroEl.getBoundingClientRect().bottom < 0);
}, {passive: true});

// ── Scroll reveal ──────────────────────────────────────────
var revealObs = new IntersectionObserver(function(entries){
  entries.forEach(function(e){
    if(e.isIntersecting){ e.target.classList.add('visible'); revealObs.unobserve(e.target); }
  });
}, {threshold: 0.1, rootMargin: '0px 0px -30px 0px'});
document.querySelectorAll('.reveal').forEach(function(el){ revealObs.observe(el); });

// ── Counter animation ──────────────────────────────────────
var counterObs = new IntersectionObserver(function(entries){
  entries.forEach(function(e){
    if(e.isIntersecting){
      var el = e.target;
      var target = parseInt(el.dataset.count);
      var start = 0, step = target / 60;
      var timer = setInterval(function(){
        start += step;
        if(start >= target){
          el.textContent = target.toLocaleString('en-IN') + '+';
          clearInterval(timer);
        } else {
          el.textContent = Math.floor(start).toLocaleString('en-IN');
        }
      }, 16);
      counterObs.unobserve(el);
    }
  });
}, {threshold: 0.5});
document.querySelectorAll('[data-count]').forEach(function(el){ counterObs.observe(el); });
</script>
