<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
/* ─── TOKENS ──────────────────────────────────────────────── */
:root{
  --white:#FFFFFF;
  --cream:#F8F5F1;
  --cream2:#EDE9E3;
  --cream3:#E2DDD6;
  --navy:#0B1F3A;
  --navy2:#162F5A;
  --navy3:#0D1525;
  --green:#1DB954;
  --green-dk:#17A349;
  --green-lt:#E6F9EE;
  --orange:#F97316;
  --gold:#F5C518;
  --red:#EF4444;
  --text:#1A1A1A;
  --text2:#4B5563;
  --text3:#9CA3AF;
  --border:#E2E2E2;
  --border2:#D1D5DB;
  --r:8px;
  --r2:14px;
  --r3:20px;
  --shadow:0 2px 12px rgba(0,0,0,.08);
  --shadow2:0 8px 32px rgba(0,0,0,.12);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-tap-highlight-color:transparent;scroll-padding-top:104px}
body{font-family:'Inter',sans-serif;color:var(--text);background:var(--cream);line-height:1.6;overflow-x:hidden}
img{display:block;max-width:100%}
a{text-decoration:none;color:inherit}
button{cursor:pointer;font-family:inherit;border:none;background:none}
button:focus-visible,a:focus-visible{outline:2px solid var(--green);outline-offset:3px;border-radius:4px}
ul{list-style:none}

/* ─── TYPOGRAPHY ──────────────────────────────────────────── */
h1,h2,h3,h4{font-family:'Sora',sans-serif;line-height:1.15}
.eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--green)}
.tag-pill{display:inline-flex;align-items:center;gap:6px;background:var(--green-lt);color:var(--green-dk);font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 12px;border-radius:999px}

/* ─── LAYOUT UTILS ────────────────────────────────────────── */
.container{max-width:1180px;margin:0 auto;padding:0 24px}
.sec{padding:80px 0}
.sec-sm{padding:56px 0}

/* ─── ANNOUNCEMENT BAR ────────────────────────────────────── */
#ann-bar{background:var(--navy);color:#fff;padding:10px 0;overflow:hidden;position:relative;z-index:200}
.ann-track{display:flex;gap:0;white-space:nowrap;animation:ticker 32s linear infinite}
.ann-track:hover{animation-play-state:paused}
.ann-item{display:inline-flex;align-items:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.04em;padding:0 48px}
.ann-item span{color:var(--gold)}
.ann-sep{color:var(--green);opacity:.7;font-size:1rem}
@keyframes ticker{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* ─── NAVIGATION ──────────────────────────────────────────── */
#nav{position:sticky;top:0;z-index:190;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:62px}
.nav-logo{display:flex;align-items:center;gap:10px;font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:800;color:var(--navy);letter-spacing:-.01em}
.logo-mark{width:36px;height:36px;background:var(--green);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.nav-links{display:flex;align-items:center;gap:28px}
.nav-links a{font-size:.85rem;font-weight:600;color:var(--text2);transition:color .2s}
.nav-links a:hover{color:var(--navy)}
.nav-right{display:flex;align-items:center;gap:12px}
.nav-cta{background:var(--green);color:#fff;font-size:.82rem;font-weight:700;padding:9px 20px;border-radius:var(--r);transition:background .2s}
.nav-cta:hover{background:var(--green-dk)}
.hamburger{display:none;flex-direction:column;gap:5px;width:28px;cursor:pointer;padding:4px}
.hamburger span{display:block;height:2px;background:var(--navy);border-radius:2px;transition:all .3s}

/* ─── NAV DRAWER ──────────────────────────────────────────── */
#nav-drawer{position:fixed;inset:0;z-index:300;pointer-events:none}
.drawer-overlay{position:absolute;inset:0;background:rgba(0,0,0,.45);opacity:0;transition:opacity .3s}
.drawer-panel{position:absolute;top:0;left:0;width:300px;height:100%;height:100dvh;background:#fff;transform:translateX(-100%);transition:transform .3s cubic-bezier(.25,.46,.45,.94);padding:24px;display:flex;flex-direction:column;gap:20px;overflow-y:auto}
.drawer-head{display:flex;align-items:center;justify-content:space-between}
.drawer-close{width:32px;height:32px;border-radius:50%;background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:var(--text2);border:none;cursor:pointer}
.drawer-links{display:flex;flex-direction:column;gap:4px}
.drawer-links a{font-size:1rem;font-weight:600;color:var(--text);padding:12px 0;border-bottom:1px solid var(--border)}
.drawer-links a:last-child{border-bottom:none}
#nav-drawer.open{pointer-events:all}
#nav-drawer.open .drawer-overlay{opacity:1}
#nav-drawer.open .drawer-panel{transform:translateX(0)}

/* ─── PDP HERO ────────────────────────────────────────────── */
#hero{background:var(--cream);padding:40px 0 60px}
.pdp-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}

/* Gallery */
.pdp-gallery{position:sticky;top:80px}
.gallery-main{position:relative;background:#fff;border-radius:var(--r2);overflow:hidden;aspect-ratio:1;border:1px solid var(--border)}
.gallery-badges{position:absolute;top:14px;left:14px;display:flex;flex-direction:column;gap:6px;z-index:2}
.g-badge{background:var(--navy);color:#fff;font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:4px 10px;border-radius:var(--r)}
.g-badge.green{background:var(--green)}
.g-badge.orange{background:var(--orange)}
.gallery-product{width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:30px}
.gallery-thumbs{display:flex;gap:8px;margin-top:10px}
.g-thumb{flex:1;aspect-ratio:1;background:#fff;border-radius:var(--r);border:2px solid var(--border);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:border-color .2s;overflow:hidden}
.g-thumb.active,.g-thumb:hover{border-color:var(--green)}

/* PDP Info */
.pdp-info{}
.pdp-breadcrumb{font-size:.75rem;color:var(--text3);margin-bottom:14px}
.pdp-breadcrumb span{color:var(--text2)}
.pdp-title{font-size:clamp(1.7rem,3vw,2.3rem);font-weight:800;color:var(--navy);margin:10px 0 6px;line-height:1.15}
.pdp-subtitle{font-size:.92rem;color:var(--text2);margin-bottom:16px;line-height:1.6}
.pdp-stars{display:flex;align-items:center;gap:8px;margin-bottom:20px;flex-wrap:wrap}
.stars{color:var(--gold);font-size:.95rem;letter-spacing:.05em}
.star-count{font-size:.82rem;font-weight:600;color:var(--text2)}
.star-count a{color:var(--green);text-decoration:underline}
.verified-tag{background:var(--green-lt);color:var(--green-dk);font-size:.68rem;font-weight:700;padding:3px 8px;border-radius:999px;letter-spacing:.06em;text-transform:uppercase}

/* Purchase toggle */
.purchase-toggle{background:#fff;border:1px solid var(--border);border-radius:var(--r2);padding:16px;margin-bottom:18px}
.toggle-label{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);margin-bottom:10px}
.toggle-options{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.toggle-opt{position:relative}
.toggle-opt input{position:absolute;opacity:0;width:0;height:0}
.toggle-opt label{display:block;border:2px solid var(--border);border-radius:var(--r);padding:12px 14px;cursor:pointer;transition:all .2s}
.toggle-opt input:checked + label{border-color:var(--green);background:var(--green-lt)}
.tog-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px}
.tog-name{font-size:.8rem;font-weight:700;color:var(--navy)}
.tog-save{background:var(--green);color:#fff;font-size:.6rem;font-weight:700;padding:2px 7px;border-radius:999px;letter-spacing:.06em;text-transform:uppercase}
.tog-price{font-size:1.1rem;font-weight:800;color:var(--navy)}
.tog-note{font-size:.72rem;color:var(--text2);line-height:1.4}

/* Size selector */
.size-row{margin-bottom:18px}
.size-label{font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);margin-bottom:8px}
.size-btns{display:flex;gap:8px;flex-wrap:wrap}
.size-btn{padding:8px 18px;border:2px solid var(--border);border-radius:var(--r);font-size:.82rem;font-weight:600;color:var(--text);background:#fff;transition:all .2s;cursor:pointer}
.size-btn.active,.size-btn:hover{border-color:var(--green);color:var(--green-dk);background:var(--green-lt)}

/* Price display */
.price-row{display:flex;align-items:baseline;gap:10px;margin-bottom:20px;flex-wrap:wrap}
.price-main{font-size:1.9rem;font-weight:800;font-family:'Sora',sans-serif;color:var(--navy)}
.price-orig{font-size:1rem;color:var(--text3);text-decoration:line-through}
.price-badge{background:var(--orange);color:#fff;font-size:.72rem;font-weight:700;padding:3px 10px;border-radius:999px}

/* Qty + ATC */
.qty-atc{display:flex;gap:10px;margin-bottom:14px}
.qty-wrap{display:flex;align-items:center;border:2px solid var(--border);border-radius:var(--r);overflow:hidden;background:#fff}
.qty-btn{width:40px;height:50px;font-size:1.2rem;font-weight:700;background:#fff;color:var(--navy);display:flex;align-items:center;justify-content:center;transition:background .2s;border:none;cursor:pointer}
.qty-btn:hover{background:var(--cream)}
.qty-num{width:44px;height:50px;display:flex;align-items:center;justify-content:center;font-size:.95rem;font-weight:700;color:var(--navy);border-left:1px solid var(--border);border-right:1px solid var(--border)}
.btn-atc{flex:1;background:var(--green);color:#fff;font-size:.92rem;font-weight:700;height:50px;border-radius:var(--r);letter-spacing:.02em;transition:background .2s;font-family:'Sora',sans-serif;border:none;cursor:pointer}
.btn-atc:hover{background:var(--green-dk)}
.btn-buynow{width:100%;background:var(--navy);color:#fff;font-size:.92rem;font-weight:700;height:50px;border-radius:var(--r);letter-spacing:.02em;margin-bottom:20px;transition:background .2s;font-family:'Sora',sans-serif;border:none;cursor:pointer}
.btn-buynow:hover{background:var(--navy2)}

/* Trust grid */
.trust-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px}
.trust-item{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:10px 12px}
.trust-icon{font-size:1.2rem;flex-shrink:0}
.trust-text{font-size:.75rem;font-weight:600;color:var(--text);line-height:1.3}
.trust-text small{display:block;font-weight:400;color:var(--text3);font-size:.68rem}

/* Accordion */
.pdp-accordions{border-top:1px solid var(--border)}
.acc-item{border-bottom:1px solid var(--border)}
.acc-head{display:flex;align-items:center;justify-content:space-between;padding:14px 0;cursor:pointer;user-select:none}
.acc-head h4{font-size:.88rem;font-weight:700;color:var(--navy)}
.acc-arrow{font-size:.9rem;color:var(--text3);transition:transform .3s;flex-shrink:0}
.acc-body{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.25,.46,.45,.94)}
.acc-body-inner{padding:0 0 16px;font-size:.85rem;color:var(--text2);line-height:1.7}
.acc-item.open .acc-arrow{transform:rotate(180deg)}
.acc-list{display:flex;flex-direction:column;gap:6px}
.acc-list li{display:flex;align-items:flex-start;gap:8px}
.acc-list li::before{content:"✓";color:var(--green);font-weight:700;flex-shrink:0;margin-top:1px}

/* ─── TRUST STRIP ─────────────────────────────────────────── */
#trust-strip{background:var(--navy);padding:28px 0}
.trust-strip-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0}
.ts-item{display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;padding:20px 16px;border-right:1px solid rgba(255,255,255,.1)}
.ts-item:last-child{border-right:none}
.ts-icon{font-size:2rem;line-height:1}
.ts-val{font-family:'Sora',sans-serif;font-size:1.3rem;font-weight:800;color:var(--gold)}
.ts-desc{font-size:.72rem;font-weight:600;color:rgba(255,255,255,.65);letter-spacing:.06em;text-transform:uppercase;line-height:1.4}

/* ─── PRESS MARQUEE ───────────────────────────────────────── */
#press{background:var(--cream2);padding:24px 0;border-top:1px solid var(--cream3);border-bottom:1px solid var(--cream3);overflow:hidden;position:relative}
#press::before,#press::after{content:'';position:absolute;top:0;bottom:0;width:80px;z-index:2;pointer-events:none}
#press::before{left:0;background:linear-gradient(to right,var(--cream2),transparent)}
#press::after{right:0;background:linear-gradient(to left,var(--cream2),transparent)}
.press-label{text-align:center;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);margin-bottom:14px}
.press-track{display:flex;gap:0;white-space:nowrap;animation:ticker 22s linear infinite}
.press-track:hover{animation-play-state:paused}
.press-item{display:inline-flex;align-items:center;padding:0 36px;font-family:'Sora',sans-serif;font-size:.95rem;font-weight:700;color:var(--text3);letter-spacing:.04em;text-transform:uppercase;transition:color .2s}
.press-item:hover{color:var(--text)}

/* ─── INGREDIENT SPOTLIGHT ────────────────────────────────── */
#ingredients{background:#fff}
.ing-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.ing-wheel{position:relative;display:flex;align-items:center;justify-content:center;min-height:360px}
.wheel-svg{width:100%;max-width:380px}
.ing-list{display:flex;flex-direction:column;gap:14px;margin-top:24px}
.ing-item{display:flex;align-items:center;gap:14px;background:var(--cream);border-radius:var(--r);padding:14px 16px}
.ing-item-icon{width:42px;height:42px;border-radius:10px;background:#fff;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0}
.ing-item-text h4{font-size:.88rem;font-weight:700;color:var(--navy);margin-bottom:2px}
.ing-item-text p{font-size:.78rem;color:var(--text2);line-height:1.4}

/* ─── BENEFITS GRID ───────────────────────────────────────── */
#benefits{background:var(--cream)}
.ben-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:40px}
.ben-card{background:#fff;border:1px solid var(--border);border-radius:var(--r2);padding:28px 24px;transition:all .25s;cursor:default}
.ben-card:hover{border-color:var(--green);background:var(--green-lt);transform:translateY(-3px);box-shadow:var(--shadow2)}
.ben-card:hover .ben-icon{background:var(--green);color:#fff}
.ben-card:hover .ben-title{color:var(--green-dk)}
.ben-icon{width:52px;height:52px;background:var(--cream);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin-bottom:16px;transition:all .25s}
.ben-title{font-size:1rem;font-weight:700;color:var(--navy);margin-bottom:8px;transition:color .25s}
.ben-desc{font-size:.82rem;color:var(--text2);line-height:1.6}

/* ─── RESULTS STATS ───────────────────────────────────────── */
#results{background:var(--navy3)}
.results-head{text-align:center;margin-bottom:48px}
.results-head h2{font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:800;color:#fff;margin:10px 0 14px}
.results-head p{color:rgba(255,255,255,.6);font-size:.95rem;max-width:480px;margin:0 auto}
.results-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0}
.result-item{padding:36px 20px;text-align:center;border-right:1px solid rgba(255,255,255,.1)}
.result-item:last-child{border-right:none}
.result-num{font-family:'Sora',sans-serif;font-size:clamp(2.2rem,4vw,3rem);font-weight:800;color:var(--green);line-height:1.1;margin-bottom:6px}
.result-label{font-size:.78rem;font-weight:600;color:rgba(255,255,255,.6);letter-spacing:.06em;text-transform:uppercase;line-height:1.4}
.result-sub{font-size:.7rem;color:rgba(255,255,255,.4);margin-top:4px}

/* ─── HOW IT WORKS ────────────────────────────────────────── */
#how{background:#fff}
.how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;position:relative;margin-top:48px}
.how-grid::before{content:'';position:absolute;top:42px;left:calc(33.33% + 20px);right:calc(33.33% + 20px);height:2px;background:repeating-linear-gradient(to right,var(--green) 0,var(--green) 8px,transparent 8px,transparent 18px);pointer-events:none}
.how-card{text-align:center}
.how-num{width:84px;height:84px;border-radius:50%;background:var(--green-lt);border:3px solid var(--green);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-family:'Sora',sans-serif;font-size:1.6rem;font-weight:800;color:var(--green)}
.how-card h3{font-size:1.05rem;font-weight:700;color:var(--navy);margin-bottom:10px}
.how-card p{font-size:.85rem;color:var(--text2);line-height:1.6}

/* ─── BEFORE / AFTER ──────────────────────────────────────── */
#ba{background:var(--cream)}
.ba-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:40px}
.ba-card{border-radius:var(--r2);overflow:hidden}
.ba-header{padding:20px 24px;font-family:'Sora',sans-serif;font-size:1rem;font-weight:800;letter-spacing:.02em;display:flex;align-items:center;gap:10px}
.ba-card.before .ba-header{background:#FEF2F2;color:var(--red)}
.ba-card.after .ba-header{background:var(--green-lt);color:var(--green-dk)}
.ba-items{padding:20px 24px;background:#fff;display:flex;flex-direction:column;gap:12px;border:1px solid var(--border);border-top:none;border-radius:0 0 var(--r2) var(--r2)}
.ba-item{display:flex;align-items:flex-start;gap:12px;font-size:.86rem;color:var(--text);line-height:1.5}
.ba-dot{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;flex-shrink:0;margin-top:1px}
.before .ba-dot{background:#FEE2E2;color:var(--red)}
.after .ba-dot{background:var(--green-lt);color:var(--green-dk)}

/* ─── REVIEWS ─────────────────────────────────────────────── */
#reviews{background:#fff}
.reviews-layout{display:grid;grid-template-columns:300px 1fr;gap:48px;align-items:start}
.review-summary{background:var(--cream);border-radius:var(--r2);padding:28px 24px;position:sticky;top:90px}
.rs-big{font-family:'Sora',sans-serif;font-size:3.8rem;font-weight:800;color:var(--navy);line-height:1}
.rs-stars{font-size:1.1rem;color:var(--gold);margin:8px 0}
.rs-count{font-size:.8rem;color:var(--text2);margin-bottom:20px}
.rs-bars{display:flex;flex-direction:column;gap:8px}
.rs-bar-row{display:flex;align-items:center;gap:10px}
.rs-bar-label{font-size:.75rem;font-weight:600;color:var(--text);width:40px;flex-shrink:0}
.rs-bar-track{flex:1;height:8px;background:var(--cream3);border-radius:999px;overflow:hidden}
.rs-bar-fill{height:100%;background:var(--gold);border-radius:999px}
.rs-bar-pct{font-size:.72rem;color:var(--text3);width:30px;text-align:right;flex-shrink:0}
.review-cards{display:flex;flex-direction:column;gap:16px}
.rev-card{background:var(--cream);border-radius:var(--r2);padding:22px;border:1px solid var(--border)}
.rev-head{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.rev-avatar{width:40px;height:40px;border-radius:50%;background:var(--navy);color:#fff;font-family:'Sora',sans-serif;font-size:.95rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rev-meta h4{font-size:.88rem;font-weight:700;color:var(--navy)}
.rev-meta p{font-size:.72rem;color:var(--text3)}
.rev-stars{color:var(--gold);font-size:.85rem;margin-bottom:8px}
.rev-title{font-size:.9rem;font-weight:700;color:var(--navy);margin-bottom:6px}
.rev-body{font-size:.83rem;color:var(--text2);line-height:1.6}
.rev-verified{display:inline-flex;align-items:center;gap:4px;font-size:.68rem;font-weight:600;color:var(--green-dk);background:var(--green-lt);padding:3px 8px;border-radius:999px;margin-top:10px}

/* ─── COMPARISON TABLE ────────────────────────────────────── */
#compare{background:var(--cream)}
.comp-wrap{overflow-x:auto;margin-top:40px;border-radius:var(--r2);border:1px solid var(--border);background:#fff}
.comp-table{width:100%;border-collapse:collapse;min-width:560px}
.comp-table th{padding:16px 20px;font-size:.8rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;border-bottom:2px solid var(--border);text-align:left}
.comp-table th:first-child{color:var(--text3)}
.comp-table th.us{color:var(--green);background:var(--green-lt)}
.comp-table td{padding:14px 20px;font-size:.84rem;border-bottom:1px solid var(--border);vertical-align:middle}
.comp-table td.us{background:var(--green-lt);font-weight:600;color:var(--green-dk)}
.comp-table tr:last-child td{border-bottom:none}
.comp-table td:first-child{font-weight:600;color:var(--navy)}
.check{color:var(--green);font-weight:700;font-size:1rem}
.cross{color:var(--red);font-weight:700;font-size:1rem}
.part{color:var(--orange)}

/* ─── FAQ ─────────────────────────────────────────────────── */
#faq{background:#fff}
.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 48px;margin-top:40px}
.faq-item{border-bottom:1px solid var(--border)}
.faq-q{display:flex;align-items:center;justify-content:space-between;padding:18px 0;cursor:pointer;user-select:none;gap:12px}
.faq-q span{font-size:.92rem;font-weight:600;color:var(--navy);line-height:1.4}
.faq-arr{font-size:.85rem;color:var(--text3);transition:transform .3s;flex-shrink:0}
.faq-a{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.25,.46,.45,.94)}
.faq-a-inner{padding:0 0 16px;font-size:.84rem;color:var(--text2);line-height:1.7}
.faq-item.open .faq-arr{transform:rotate(180deg)}

/* ─── GUARANTEE ───────────────────────────────────────────── */
#guarantee{background:var(--navy3);padding:80px 0}
.guar-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:40px;align-items:center}
.guar-badge{text-align:center}
.guar-badge-circle{width:140px;height:140px;border-radius:50%;border:4px solid var(--gold);display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0 auto;gap:2px;background:rgba(255,255,255,.05)}
.guar-badge-circle strong{font-family:'Sora',sans-serif;font-size:1.6rem;font-weight:800;color:var(--gold);line-height:1}
.guar-badge-circle small{font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);opacity:.8}
.guar-text h2{font-size:clamp(1.6rem,2.8vw,2.2rem);font-weight:800;color:#fff;margin-bottom:12px;line-height:1.2}
.guar-text p{font-size:.9rem;color:rgba(255,255,255,.65);line-height:1.7;margin-bottom:20px}
.guar-text ul{display:flex;flex-direction:column;gap:8px}
.guar-text li{display:flex;align-items:center;gap:8px;font-size:.85rem;color:rgba(255,255,255,.75)}
.guar-text li::before{content:"✓";color:var(--green);font-weight:700;flex-shrink:0}
.guar-action{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center}
.btn-main{display:inline-flex;align-items:center;justify-content:center;background:var(--green);color:#fff;font-family:'Sora',sans-serif;font-size:.95rem;font-weight:700;padding:16px 32px;border-radius:var(--r);transition:background .2s;border:none;cursor:pointer;width:100%}
.btn-main:hover{background:var(--green-dk)}
.btn-ghost{display:inline-flex;align-items:center;justify-content:center;background:transparent;color:rgba(255,255,255,.7);font-size:.85rem;font-weight:600;padding:12px 24px;border-radius:var(--r);border:1px solid rgba(255,255,255,.2);transition:all .2s;cursor:pointer;width:100%}
.btn-ghost:hover{background:rgba(255,255,255,.08);color:#fff}
.guar-note{font-size:.72rem;color:rgba(255,255,255,.4)}

/* ─── FOOTER ──────────────────────────────────────────────── */
#footer{background:var(--navy);padding:60px 0 32px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:48px}
.footer-brand p{font-size:.82rem;color:rgba(255,255,255,.5);line-height:1.7;max-width:240px}
.footer-social{display:flex;gap:10px;margin-top:16px}
.f-social{width:36px;height:36px;border-radius:8px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;font-size:.9rem;color:rgba(255,255,255,.6);transition:all .2s}
.f-social:hover{background:var(--green);color:#fff}
.footer-col h4{font-size:.8rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-bottom:14px}
.footer-col ul{display:flex;flex-direction:column;gap:8px}
.footer-col li a{font-size:.82rem;color:rgba(255,255,255,.55);transition:color .2s}
.footer-col li a:hover{color:#fff}
.footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
.footer-bottom p{font-size:.75rem;color:rgba(255,255,255,.35)}
.footer-payment{display:flex;gap:8px;align-items:center}
.pay-badge{background:rgba(255,255,255,.08);border-radius:4px;padding:4px 8px;font-size:.65rem;font-weight:700;color:rgba(255,255,255,.5);letter-spacing:.04em}

/* ─── STICKY MOBILE ATC ───────────────────────────────────── */
#sticky-atc{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid var(--border);padding:12px 16px;padding-bottom:calc(12px + env(safe-area-inset-bottom));z-index:150;transform:translateY(100%);transition:transform .35s cubic-bezier(.25,.46,.45,.94);box-shadow:0 -4px 20px rgba(0,0,0,.1)}
#sticky-atc.visible{transform:translateY(0)}
.satc-inner{display:flex;align-items:center;gap:12px}
.satc-info{flex:1;min-width:0}
.satc-name{font-size:.82rem;font-weight:700;color:var(--navy);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.satc-price{font-size:.9rem;font-weight:800;color:var(--green)}
.satc-btn{background:var(--green);color:#fff;font-size:.85rem;font-weight:700;padding:12px 24px;border-radius:var(--r);white-space:nowrap;transition:background .2s;font-family:'Sora',sans-serif;border:none;cursor:pointer}
.satc-btn:hover{background:var(--green-dk)}

/* ─── SECTION HEADERS ─────────────────────────────────────── */
.sec-hd{text-align:center;max-width:620px;margin:0 auto}
.sec-hd h2{font-size:clamp(1.7rem,3vw,2.3rem);font-weight:800;color:var(--navy);margin:8px 0 14px}
.sec-hd p{font-size:.9rem;color:var(--text2);line-height:1.7}
.sec-hd-left{text-align:left;margin:0}

/* ─── COUNTDOWN ───────────────────────────────────────────── */
.countdown-row{display:flex;align-items:center;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.cd-label{font-size:.75rem;font-weight:600;color:var(--orange);text-transform:uppercase;letter-spacing:.06em}
.cd-blocks{display:flex;gap:6px;align-items:center}
.cd-block{background:var(--navy);color:#fff;font-family:'Sora',sans-serif;font-size:1.1rem;font-weight:800;padding:6px 10px;border-radius:6px;min-width:40px;text-align:center;line-height:1}
.cd-sep{font-size:1rem;font-weight:700;color:var(--orange)}
.cd-unit{font-size:.55rem;letter-spacing:.06em;display:block;opacity:.6;font-weight:400}

/* ─── SCROLL REVEAL ───────────────────────────────────────── */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-d1{transition-delay:.1s}
.reveal-d2{transition-delay:.2s}
.reveal-d3{transition-delay:.3s}

/* ─── RESPONSIVE ──────────────────────────────────────────── */
@media(max-width:1024px){
  .pdp-grid{gap:32px}
  .ing-grid{gap:40px}
  .guar-grid{grid-template-columns:1fr 1.5fr 1fr;gap:24px}
  .footer-grid{grid-template-columns:1.5fr 1fr 1fr 1fr}
}
@media(max-width:900px){
  .pdp-grid{grid-template-columns:1fr}
  .pdp-gallery{position:static}
  .ing-grid{grid-template-columns:1fr}
  .ing-wheel{min-height:auto}
  .reviews-layout{grid-template-columns:1fr}
  .review-summary{position:static}
  .faq-grid{grid-template-columns:1fr}
  .guar-grid{grid-template-columns:1fr;text-align:center}
  .guar-text ul{align-items:center}
  .guar-action{flex-direction:row;max-width:400px;margin:0 auto}
  .btn-main,.btn-ghost{width:auto;flex:1}
  .footer-grid{grid-template-columns:1fr 1fr;gap:32px}
  .how-grid{grid-template-columns:1fr;gap:32px}
  .how-grid::before{display:none}
  .trust-strip-grid{grid-template-columns:repeat(2,1fr)}
  .ts-item{border-bottom:1px solid rgba(255,255,255,.1)}
  .ts-item:nth-child(2){border-right:none}
  .ts-item:nth-child(3){border-bottom:none}
  .ts-item:nth-child(4){border-right:none;border-bottom:none}
}
@media(max-width:680px){
  .sec{padding:52px 0}
  .sec-sm{padding:36px 0}
  #hero{padding:24px 0 40px}
  #guarantee{padding:52px 0}
  .ben-grid{grid-template-columns:1fr 1fr}
  .results-grid{grid-template-columns:repeat(2,1fr)}
  .result-item{border-bottom:1px solid rgba(255,255,255,.1)}
  .result-item:nth-child(2){border-right:none}
  .result-item:nth-child(3){border-bottom:none}
  .result-item:nth-child(4){border-right:none;border-bottom:none}
  .ba-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr}
  .footer-bottom{flex-direction:column;align-items:flex-start;gap:10px}
  .guar-action{flex-direction:column}
  .btn-main,.btn-ghost{width:100%}
  .nav-links{display:none}
  .hamburger{display:flex}
  .nav-cta{display:none}
  .toggle-options{grid-template-columns:1fr}
}
@media(max-width:480px){
  .container{padding:0 16px}
  .ben-grid{grid-template-columns:1fr}
  .trust-strip-grid{grid-template-columns:repeat(2,1fr)}
}
